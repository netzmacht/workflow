{
  "receipts": [
    "projects/library"
  ],
  "config": {
    "phpConstraint": "^8.3",
    "directories": [
      "spec"
    ]
  },
  "tools": {
    "composer": {
      "namespace": "Cowegis\\Bundle\\Contao"
    },
    "phpcq": {
      "plugins": {
        "phpunit": false,
        "phpspec": true,
        "rector": false
      },
      "defaults": {
        "repositories": [
          "vendor/netzmacht/phpspec-phpcq-plugin/repository.json"
        ]
      },
      "presets": {
        "composer-require-checker": {
          "tasks": {
            "composer-require-checker": {
              "config":{
                "config_file": ".composer-require-checker.json"
              }
            }
          }
        },
        "phpcpd": {
          "tasks": {
            "phpcpd": {
              "config": {
                "exclude": [
                  "spec/Manager/WorkflowManagerSpec.php",
                  "spec/Flow/Condition/Transition/ConditionCollectionSpec.php",
                  "spec/Flow/Condition/Transition/AndConditionSpec.php",
                  "spec/Flow/Condition/Workflow/ConditionCollectionSpec.php",
                  "spec/Flow/Condition/Transition/OrConditionSpec.php"
                ]
              }
            }
          }
        }
      }
    },
    "psalm": {
      "configuration": {
        "errorLevel": "3"
      },
      "project-files": {
        "directories": ["src"]
      }
    }
  }
}
